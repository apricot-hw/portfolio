---
import type { WorkItem } from '../data/works';
import { withBase } from '../utils/paths';

interface Props {
  item: WorkItem;
}

const { item } = Astro.props;
const detailUrl = withBase(`works/${item.slug}/`);

const statusLabelMap = {
  prototype: 'Prototype',
  study: 'Study',
  release: 'Release',
} as const;
---

<article class="card work-card">
  <a class="work-thumbnail" href={detailUrl} aria-label={`${item.title}の詳細を見る`}>
    <img
      src={withBase(item.thumbnail.src)}
      alt={item.thumbnail.alt}
      class:list={{ 'thumbnail-top': item.thumbnail.position === 'center top' }}
      loading="lazy"
      decoding="async"
    />
  </a>
  <p class="tag">{statusLabelMap[item.status]}</p>
  <h3>{item.title}</h3>
  <p>{item.summary}</p>
  <div class="tags" aria-label="Tags">
    {item.tags.map((tag) => <span class="tag">{tag}</span>)}
  </div>
  <p>
    <small>{item.year} / {item.role}</small>
  </p>
  <a class="cta-link" href={detailUrl}>View detail</a>
</article>
